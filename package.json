{
  "name": "puzzle-hunt-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop puzzle-hunt workspace with multi-tab puzzle browsing, a persistent canvas, sleeping tools, and offline puzzle snapshots.",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-source.js && npm test",
    "dist": "npm run check && electron-builder",
    "dist:dir": "npm run check && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.puzzlehunt.workbench",
    "productName": "Puzzle Hunt Workbench",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Utility"
    }
  }
}
